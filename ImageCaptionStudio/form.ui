          </property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="centerPanel">
       <layout class="QVBoxLayout" name="centerLayout">
        <item>
         <widget class="QLabel" name="labelPreview">
          <property name="text">
           <string>图片预览</string>
          </property>
