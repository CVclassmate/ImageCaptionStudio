            </property>
           </widget>
          </item>
          <item>
           <widget class="QSpinBox" name="spinPromptFontSize">
            <property name="minimum">
             <number>8</number>
            </property>
            <property name="maximum">
             <number>48</number>
            </property>
            <property name="singleStep">
             <number>1</number>
            </property>
            <property name="suffix">
